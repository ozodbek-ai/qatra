generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum UserActivityType {
  LOGIN
  LOGOUT
  LESSON_VIEW
  QUIZ_ATTEMPT
  COURSE_VIEW
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

model User {
  id       String   @id @default(cuid())
  fullName String
  email    String   @unique
  password String
  role     UserRole @default(STUDENT)

  enrollments    Enrollment[]
  quizAttempts   QuizAttempt[]
  lessonProgress LessonProgress[]
  activities     UserActivity[]

  courseCompletions CourseCompletion[]
  certificates      Certificate[]

  isActive Boolean @default(true)

  avatarUrl   String?
  lastLoginAt DateTime?

  reviews Review[]

  reelLikes    ReelLike[]
  reelComments ReelComment[]

  emailVerified Boolean @default(false)

  passwordResetTokens PasswordResetToken[]

  conversations ConversationMember[]
  sentMessages  Message[]            @relation("MessageSender")

  challengesCreated  Challenge[] @relation("ChallengesCreated")
  challengesReceived Challenge[] @relation("ChallengesReceived")
  challengesWon      Challenge[] @relation("ChallengeWinner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id String @id @default(cuid())

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model ConversationMember {
  id String @id @default(cuid())

  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  senderId       String
  reelId         String?

  text String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reel         Reel?        @relation(fields: [reelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([reelId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Course {
  id String @id @default(cuid())

  title       String
  slug        String @unique
  description String

  imageUrl String?

  price Decimal @db.Decimal(10, 2)

  category String?

  duration Int @default(0)

  studentsCount Int @default(0)

  averageRating Float @default(0)

  lessons Lesson[]

  enrollments Enrollment[]

  completions CourseCompletion[]

  certificates Certificate[]

  level CourseLevel @default(BEGINNER)

  isPublished Boolean @default(false)

  isActive Boolean @default(true)

  reviews Review[]

  challenges Challenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

model Lesson {
  id String @id @default(cuid())

  title       String
  description String?

  videoUrl String?

  duration Int

  order Int

  isPreview Boolean @default(false)

  isPublished Boolean @default(false)

  courseId String

  progress LessonProgress[]

  quiz Quiz?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id String @id @default(cuid())

  userId   String
  courseId String

  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id String @id @default(cuid())

  userId   String
  lessonId String

  completed Boolean @default(false)

  completedAt DateTime?

  lastViewedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Quiz {
  id String @id @default(cuid())

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  passPercentage Int @default(70)

  questions Question[]

  attempts QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  question String

  type QuestionType @default(SINGLE)

  options Option[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text String

  isCorrect Boolean @default(false)

  createdAt DateTime @default(now())
}

model QuizAttempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  score Int
  total Int

  percentage Int @default(0)

  passed Boolean @default(false)

  createdAt DateTime @default(now())
}

model CourseCompletion {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  certificate Certificate?

  @@unique([userId, courseId])
}

model Certificate {
  id String @id @default(cuid())

  certificateNo String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completionId String           @unique
  completion   CourseCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)

  issuedAt DateTime @default(now())
}

model Review {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  rating Int

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model SiteSettings {
  id String @id @default(cuid())

  platformName String @default("Qatra")
  description  String @default("Learning Management System")

  logoUrl String?

  supportEmail String?

  defaultQuizPassPercentage Int @default(70)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserActivity {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type UserActivityType

  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
  @@index([startedAt])
}

model Reel {
  id String @id @default(cuid())

  title       String
  description String?

  videoUrl     String
  thumbnailUrl String?

  isPublished Boolean @default(false)

  categoryId String?

  category ReelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  likes    ReelLike[]
  comments ReelComment[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([createdAt])
  @@index([categoryId])
}

model ReelCategory {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  description String?
  imageUrl    String?

  reels Reel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model ReelLike {
  id String @id @default(cuid())

  userId String
  reelId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, reelId])
  @@index([reelId])
}

model ReelComment {
  id String @id @default(cuid())

  userId String
  reelId String

  text String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reelId])
  @@index([userId])
}

model Challenge {
  id String @id @default(cuid())

  challengerId String
  opponentId   String
  courseId     String

  status ChallengeStatus @default(PENDING)

  challengerScore Int @default(0)
  opponentScore   Int @default(0)

  challengerCompletedAt DateTime?
  opponentCompletedAt   DateTime?

  winnerId String?

  winner User? @relation("ChallengeWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenger User   @relation("ChallengesCreated", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User   @relation("ChallengesReceived", fields: [opponentId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([opponentId])
  @@index([courseId])
  @@index([status])
}
